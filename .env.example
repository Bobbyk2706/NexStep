# Copy this file to .env and fill in the values for your environment.
DATABASE_URL=your_DATABASE_URL_here
JWT_SECRET_KEY=your_JWT_SECRET_KEY_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OLLAMA_HOST=http://localhost:11434
LOCAL_AI_MODEL=qwen3:1.7b

TAVILY_API_KEY=your_TAVILY_API_KEY_here
SERPER_API_KEY=your_SERPER_API_KEY_here
SEARCH_PROVIDER_ORDER=tavily,serper

# ---- AI extraction pipeline v2 (all optional; defaults shown) ----------
# Tokens-per-minute your Groq plan allows. Requests are queued/routed so
# they never exceed it. 0 disables the client-side limiter.
NEXSTEP_GROQ_TPM=8000
NEXSTEP_OPENROUTER_TPM=0
NEXSTEP_LOCAL_TPM=0
# Fraction of the limit actually used (safety margin for estimation error).
NEXSTEP_TPM_SAFETY=0.9
# Longest a request waits for budget before moving to the next provider,
# and the longer wait allowed when no other provider is left.
NEXSTEP_AI_MAX_WAIT_SECONDS=25
NEXSTEP_AI_LAST_RESORT_WAIT_SECONDS=120
# Upper bound for one request (input + output) when no limiter applies.
NEXSTEP_MAX_REQUEST_TOKENS=7000
# Reasoning effort for gpt-oss models on Groq: low | medium | high
NEXSTEP_GROQ_REASONING_EFFORT=low

EMAIL_PROVIDER=smtp
EMAIL_API_KEY=your_email_api_key_here
EMAIL_FROM=NexStep <your_verified_sender@example.com>
FRONTEND_URL=http://localhost:5173